# ==============================================================================
# CREWN — Staging & Production Environment Variables Specification
# ==============================================================================
# Copy this template to .env for staging or production deployment.
# NEVER commit real production secrets, credentials, or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL
# ------------------------------------------------------------------------------
# Canonical application base URL used in auth callbacks, verification emails,
# invitation links, and webhook endpoint verification.
APP_URL="https://staging.crewn.com"
NEXT_PUBLIC_APP_URL="https://staging.crewn.com"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Managed PostgreSQL connection string (AWS RDS, Neon, Supabase, Railway, etc.)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&schema=public
DATABASE_URL="postgresql://db_user:db_password@staging-db.example.com:5432/crewn_staging?sslmode=require&schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECRETS
# ------------------------------------------------------------------------------
# High-entropy 32+ character secret for HMAC signing of tokens and session verification.
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-base64-random-secret-here-min-32-chars"

# Mandatory high-entropy 32+ character secret for HMAC-signed private download URLs
# Generate with: openssl rand -hex 32
STORAGE_SIGNING_SECRET="your-32-byte-hex-storage-signing-secret-here-min-32-chars"

# ------------------------------------------------------------------------------
# 4. EMAIL PROVIDER
# ------------------------------------------------------------------------------
# Production transactional email service (Resend / SendGrid / Amazon SES).
# If omitted, emails fall back to console logging in development.
RESEND_API_KEY="re_staging_placeholder_key"
EMAIL_FROM="Crewn Staging <notifications@staging.crewn.com>"

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (S3-Compatible / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Choose: "local" (for local filesystem) or "s3" / "r2" (for cloud object storage)
STORAGE_PROVIDER="s3"
AWS_S3_BUCKET="crewn-staging-storage"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_or_r2_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_or_r2_secret_access_key"
# Optional custom S3 endpoint (required for Cloudflare R2, MinIO, or Wasabi)
AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# Optional CDN URL for accelerated public asset delivery
STORAGE_CDN_URL="https://assets-staging.crewn.com"

# ------------------------------------------------------------------------------
# 6. RAZORPAY (Staging / Sandbox Payment Gateway)
# ------------------------------------------------------------------------------
# Use TEST mode keys in staging (starts with rzp_test_).
# DO NOT use live rzp_live_ keys in staging.
RAZORPAY_KEY_ID="rzp_test_your_sandbox_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_sandbox_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_staging_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_sandbox_key_id"

# ------------------------------------------------------------------------------
# 7. REDIS / DISTRIBUTED RATE LIMITING
# ------------------------------------------------------------------------------
# Upstash REST or standard Redis for distributed multi-instance sliding window rate limiting.
# If omitted or unreachable, gracefully falls back to in-memory sliding window.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"
# Alternative standard Redis URL:
# REDIS_URL="redis://default:password@staging-redis.example.com:6379"

# ------------------------------------------------------------------------------
# 8. BACKGROUND JOBS & CRON SCHEDULING
# ------------------------------------------------------------------------------
# Bearer secret used to authenticate external cron triggers (Vercel Cron, GitHub Actions, AWS EventBridge)
# invoking /api/cron or /api/jobs/run.
CRON_SECRET="your-secure-cron-secret-for-scheduled-job-triggers"

# ------------------------------------------------------------------------------
# 9. OBSERVABILITY & LOGGING
# ------------------------------------------------------------------------------
# Structured logging level: "debug" | "info" | "warn" | "error"
LOG_LEVEL="info"
